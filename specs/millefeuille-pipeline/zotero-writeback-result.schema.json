{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fr-meyer/millefeuille/specs/millefeuille-pipeline/zotero-writeback-result.schema.json",
  "title": "Millefeuille Zotero Writeback Result",
  "type": "object",
  "required": ["schema_version", "paper_id", "run_id", "source_hash", "mode", "status", "source_item_version", "item_version", "operation_count", "receipt_digest", "audit_digest", "integrity"],
  "additionalProperties": false,
  "$defs": {
    "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "properties": {
    "schema_version": {"const": "millefeuille-zotero-writeback-result/v0.1"},
    "paper_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_hash": {"type": "string", "pattern": "^sha256(?:-aggregate)?:[0-9a-f]{64}$"},
    "mode": {"const": "approved-live"},
    "status": {"enum": ["written", "skipped", "failed", "needs-review"]},
    "source_item_version": {"$ref": "#/$defs/safeInteger"},
    "item_version": {"$ref": "#/$defs/safeInteger"},
    "operation_count": {"$ref": "#/$defs/safeInteger"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "audit_digest": {"$ref": "#/$defs/digest"},
    "integrity": {
      "type": "object",
      "required": ["algorithm", "content_digest"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
