{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/millefeuille/taxonomy-change-review.schema.json",
  "title": "Millefeuille Taxonomy Change Review",
  "x-millefeuille-semantic-validation": [
    "content_identity equals canonical SHA-256 excluding content_identity",
    "proposal and candidate identities match the reviewed proposal",
    "reviewed_at does not predate requested_at",
    "a required-role reviewer_id is an accountable actor identity distinct from proposal requested_by"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "proposal_content_identity",
    "candidate_content_identity",
    "role",
    "decision",
    "reviewer_id",
    "reviewed_at",
    "notes",
    "content_identity"
  ],
  "properties": {
    "schema_version": {
      "const": "millefeuille-taxonomy-change-review/v0.1"
    },
    "review_id": {"$ref": "#/$defs/safeId"},
    "proposal_content_identity": {"$ref": "#/$defs/contentIdentity"},
    "candidate_content_identity": {"$ref": "#/$defs/contentIdentity"},
    "role": {
      "enum": [
        "taxonomy-owner",
        "qa-lead",
        "operations-lead",
        "subject-matter-reviewer"
      ]
    },
    "decision": {"enum": ["approve", "reject"]},
    "reviewer_id": {"$ref": "#/$defs/text"},
    "reviewed_at": {"$ref": "#/$defs/timestamp"},
    "notes": {"$ref": "#/$defs/text"},
    "content_identity": {"$ref": "#/$defs/contentIdentity"}
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^\\S(?:[^\\r\\n\\u0000-\\u001f]*\\S)?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "contentIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
