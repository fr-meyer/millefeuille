{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Millefeuille acceptance batch summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "status",
    "counts",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "millefeuille-acceptance-batch-summary/v0.1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "enum": [
        "pass",
        "needs-review"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs",
        "passed",
        "needs_review"
      ],
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "needs_review": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_id",
          "run_id",
          "source_hash",
          "status",
          "summary_ref"
        ],
        "properties": {
          "paper_id": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "source_hash": {
            "type": "string",
            "pattern": "^sha256(?:-aggregate)?:[a-f0-9]{64}$"
          },
          "status": {
            "enum": [
              "pass",
              "needs-review"
            ]
          },
          "summary_ref": {
            "type": "string",
            "minLength": 1
          },
          "review_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
