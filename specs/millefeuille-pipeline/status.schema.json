{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fr-meyer/millefeuille/specs/millefeuille-pipeline/status.schema.json",
  "title": "Millefeuille Read-only Joined Status",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "run_id",
    "source_hash",
    "mode",
    "observation_scope",
    "authority",
    "status",
    "canonical",
    "stages",
    "index",
    "acceptance",
    "classification",
    "zotero_writeback",
    "observations",
    "private_content_emitted",
    "credentials_loaded",
    "external_calls_performed",
    "integrity"
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "counts": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/safeInteger"}
    },
    "component": {
      "type": "object",
      "required": ["state", "content_digest"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["observed", "not-observed"]},
        "content_digest": {"$ref": "#/$defs/nullableDigest"}
      }
    },
    "indexLane": {
      "type": "object",
      "required": ["lane", "status"],
      "additionalProperties": false,
      "properties": {
        "lane": {"enum": ["openkb", "pageindex", "condb", "chatindex", "other"]},
        "status": {"enum": ["skipped", "previewed", "written", "failed", "needs-review", "not-started"]}
      }
    },
    "writtenLane": {
      "type": "object",
      "required": ["lane", "status"],
      "additionalProperties": false,
      "properties": {
        "lane": {"enum": ["openkb", "pageindex", "condb", "chatindex", "other"]},
        "status": {"const": "written"}
      }
    },
    "observationBase": {
      "type": "object",
      "required": ["state", "required", "source", "authoritative", "content_digest", "summary"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["observed", "not-observed"]},
        "required": {"type": "boolean"},
        "source": {"oneOf": [{"const": "operator-supplied-local-observation"}, {"type": "null"}]},
        "authoritative": {"const": false},
        "content_digest": {"$ref": "#/$defs/nullableDigest"},
        "summary": {}
      }
    },
    "zoteroSummary": {
      "type": "object",
      "required": ["status", "item_version", "tag_state", "note_state"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["consistent", "drifted", "needs-review"]},
        "item_version": {"$ref": "#/$defs/safeInteger"},
        "tag_state": {"enum": ["consistent", "drifted", "not-observed"]},
        "note_state": {"enum": ["consistent", "drifted", "not-observed"]}
      }
    },
    "providerSummary": {
      "type": "object",
      "required": ["status", "record_digest", "call_count", "input_tokens", "output_tokens", "total_tokens"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["within-approved-limits", "exceeded-approved-limits", "needs-review"]},
        "record_digest": {"$ref": "#/$defs/digest"},
        "call_count": {"$ref": "#/$defs/safeInteger"},
        "input_tokens": {"$ref": "#/$defs/safeInteger"},
        "output_tokens": {"$ref": "#/$defs/safeInteger"},
        "total_tokens": {"$ref": "#/$defs/safeInteger"}
      }
    },
    "ledgerSummary": {
      "type": "object",
      "required": ["status", "lanes", "index_status_digest"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["consistent", "drifted", "needs-review"]},
        "lanes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/writtenLane"}},
        "index_status_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "qualitySummary": {
      "type": "object",
      "required": ["status", "checks_total", "checks_passed", "checks_failed", "record_digest"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["passed", "needs-review", "failed"]},
        "checks_total": {"$ref": "#/$defs/safeInteger"},
        "checks_passed": {"$ref": "#/$defs/safeInteger"},
        "checks_failed": {"$ref": "#/$defs/safeInteger"},
        "record_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "writebackSummary": {
      "type": "object",
      "required": ["status", "operation_count", "receipt_digest", "audit_digest", "record_digest"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["written", "skipped", "failed", "needs-review"]},
        "operation_count": {"$ref": "#/$defs/safeInteger"},
        "receipt_digest": {"$ref": "#/$defs/digest"},
        "audit_digest": {"$ref": "#/$defs/digest"},
        "record_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "zoteroObservation": {"allOf": [{"$ref": "#/$defs/observationBase"}, {"properties": {"summary": {"oneOf": [{"$ref": "#/$defs/zoteroSummary"}, {"type": "null"}]}}}]},
    "providerObservation": {"allOf": [{"$ref": "#/$defs/observationBase"}, {"properties": {"summary": {"oneOf": [{"$ref": "#/$defs/providerSummary"}, {"type": "null"}]}}}]},
    "ledgerObservation": {"allOf": [{"$ref": "#/$defs/observationBase"}, {"properties": {"summary": {"oneOf": [{"$ref": "#/$defs/ledgerSummary"}, {"type": "null"}]}}}]},
    "qualityObservation": {"allOf": [{"$ref": "#/$defs/observationBase"}, {"properties": {"summary": {"oneOf": [{"$ref": "#/$defs/qualitySummary"}, {"type": "null"}]}}}]},
    "writebackObservation": {"allOf": [{"$ref": "#/$defs/observationBase"}, {"properties": {"summary": {"oneOf": [{"$ref": "#/$defs/writebackSummary"}, {"type": "null"}]}}}]}
  },
  "properties": {
    "schema_version": {"const": "millefeuille-status/v0.2"},
    "paper_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_hash": {"type": "string", "pattern": "^sha256(?:-aggregate)?:[0-9a-f]{64}$"},
    "mode": {"enum": ["not-observed", "preview", "approved-live"]},
    "observation_scope": {"enum": ["canonical-source-pack", "artifact-index-progressive"]},
    "authority": {
      "type": "object",
      "required": ["source", "authoritative"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "operator-supplied-local-observation"},
        "authoritative": {"const": false}
      }
    },
    "status": {
      "type": "object",
      "required": ["state", "complete", "observationally_ready", "authoritative_live_complete", "blocking_items", "stage_counts", "index_counts"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["observational-live-ready", "preview-complete", "observed-complete", "needs-review"]},
        "complete": {"type": "boolean"},
        "observationally_ready": {"type": "boolean"},
        "authoritative_live_complete": {"const": false},
        "blocking_items": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "stage_counts": {"$ref": "#/$defs/counts"},
        "index_counts": {"$ref": "#/$defs/counts"}
      }
    },
    "canonical": {
      "type": "object",
      "required": ["source_pack", "stage_manifest", "artifact_index"],
      "additionalProperties": false,
      "properties": {
        "source_pack": {"$ref": "#/$defs/component"},
        "stage_manifest": {"$ref": "#/$defs/component"},
        "artifact_index": {"$ref": "#/$defs/component"}
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["not-started", "skipped", "passed", "failed", "needs-review", "manual-gate"]}
        }
      }
    },
    "index": {
      "type": "object",
      "required": ["state", "lanes", "content_digest"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["observed", "not-observed"]},
        "lanes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/indexLane"}},
        "content_digest": {"$ref": "#/$defs/nullableDigest"}
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["state", "status", "content_digest"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["observed", "not-observed"]},
        "status": {"oneOf": [{"enum": ["pass", "needs-review"]}, {"type": "null"}]},
        "content_digest": {"$ref": "#/$defs/nullableDigest"}
      }
    },
    "classification": {
      "type": "object",
      "required": ["state", "status", "content_digest"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["observed", "not-observed", "incomplete"]},
        "status": {"oneOf": [{"enum": ["classified", "needs-review", "adjudication-required"]}, {"type": "null"}]},
        "content_digest": {"$ref": "#/$defs/nullableDigest"}
      }
    },
    "zotero_writeback": {
      "type": "object",
      "required": ["state", "mode", "status", "completion", "content_digest", "result_content_digest"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["observed", "indexed-preview", "not-observed"]},
        "mode": {"enum": ["none", "preview", "approved-live"]},
        "status": {"enum": ["not-planned", "previewed", "written", "skipped", "failed", "needs-review", "manual-gate", "not-started"]},
        "completion": {"enum": ["live-result-required", "preview-complete", "not-applicable", "incomplete"]},
        "content_digest": {"$ref": "#/$defs/nullableDigest"},
        "result_content_digest": {"$ref": "#/$defs/nullableDigest"}
      }
    },
    "observations": {
      "type": "object",
      "required": ["index-ledger", "provider-usage", "quality", "writeback-result", "zotero-live-state"],
      "additionalProperties": false,
      "properties": {
        "index-ledger": {"$ref": "#/$defs/ledgerObservation"},
        "provider-usage": {"$ref": "#/$defs/providerObservation"},
        "quality": {"$ref": "#/$defs/qualityObservation"},
        "writeback-result": {"$ref": "#/$defs/writebackObservation"},
        "zotero-live-state": {"$ref": "#/$defs/zoteroObservation"}
      }
    },
    "private_content_emitted": {"const": false},
    "credentials_loaded": {"const": false},
    "external_calls_performed": {"const": false},
    "integrity": {
      "type": "object",
      "required": ["algorithm", "content_digest"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "sha256"},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
