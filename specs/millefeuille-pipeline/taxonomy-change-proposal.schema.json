{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/millefeuille/taxonomy-change-proposal.schema.json",
  "title": "Millefeuille Taxonomy Change Proposal",
  "x-millefeuille-semantic-validation": [
    "content_identity equals canonical SHA-256 excluding content_identity",
    "the base and candidate are released exact registry versions",
    "candidate previous_version and previous_content_identity equal the exact base version and content identity",
    "stable IDs are not deleted, re-leveled, or reparented",
    "affected_entry_ids equals the complete entry diff",
    "specific add, clarify, rename, deprecate, split, and merge operations match their enforceable registry diff shapes; mixed is explicit",
    "rollback_source is present only for rollback",
    "the rollback source is the exact content-addressed immediate predecessor of the base",
    "a rollback candidate restores source entries exactly, retains base-only entries byte-for-value except active status becomes deprecated, leaves already-deprecated base-only entries unchanged, and has no IDs outside the base/source union"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "operation",
    "base_registry",
    "candidate_registry",
    "affected_entry_ids",
    "reason",
    "evidence_refs",
    "impact",
    "migration",
    "requested_by",
    "requested_at",
    "content_identity"
  ],
  "properties": {
    "schema_version": {
      "const": "millefeuille-taxonomy-change-proposal/v0.1"
    },
    "change_id": {"$ref": "#/$defs/safeId"},
    "operation": {
      "enum": [
        "add",
        "clarify",
        "rename",
        "deprecate",
        "split",
        "merge",
        "mixed",
        "rollback"
      ]
    },
    "base_registry": {"$ref": "#/$defs/registryBinding"},
    "candidate_registry": {"$ref": "taxonomy-registry.schema.json"},
    "affected_entry_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entryId"}
    },
    "reason": {"$ref": "#/$defs/text"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "summary", "estimated_affected_records"],
      "properties": {
        "risk": {"enum": ["low", "medium", "high"]},
        "summary": {"$ref": "#/$defs/text"},
        "estimated_affected_records": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historical_reclassification",
        "instructions",
        "active_batch_policy",
        "rollback_source"
      ],
      "properties": {
        "historical_reclassification": {
          "enum": ["none", "review", "required"]
        },
        "instructions": {"$ref": "#/$defs/text"},
        "active_batch_policy": {"const": "preserve-locked-version"},
        "rollback_source": {
          "oneOf": [
            {"$ref": "#/$defs/registryBinding"},
            {"type": "null"}
          ]
        }
      }
    },
    "requested_by": {"$ref": "#/$defs/text"},
    "requested_at": {"$ref": "#/$defs/timestamp"},
    "content_identity": {"$ref": "#/$defs/contentIdentity"}
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "rollback"}}},
      "then": {
        "properties": {
          "migration": {
            "properties": {
              "rollback_source": {"$ref": "#/$defs/registryBinding"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "migration": {
            "properties": {"rollback_source": {"type": "null"}}
          }
        }
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "entryId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^\\S(?:[^\\r\\n\\u0000-\\u001f]*\\S)?$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "contentIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "taxonomy_version", "content_identity"],
      "properties": {
        "registry_id": {"$ref": "#/$defs/safeId"},
        "taxonomy_version": {"$ref": "#/$defs/safeId"},
        "content_identity": {"$ref": "#/$defs/contentIdentity"}
      }
    }
  }
}
