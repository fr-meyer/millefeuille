{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fr-meyer/millefeuille/specs/millefeuille-pipeline/summary-preparation.schema.json",
  "title": "Millefeuille Summary Preparation Package",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "paper_id",
    "identity",
    "inputs",
    "profile",
    "execution_plans",
    "work_units",
    "execution",
    "writes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "millefeuille-summary-preparation/v0.1"},
    "status": {"const": "prepared-no-call"},
    "paper_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "identity": {
      "type": "object",
      "required": [
        "source_type",
        "item_key",
        "attachment_key",
        "canonical_filename",
        "expected_sha256",
        "page_count",
        "selected_route",
        "zotero_version"
      ],
      "additionalProperties": false,
      "properties": {
        "source_type": {"const": "zotero"},
        "item_key": {"type": "string", "minLength": 1},
        "attachment_key": {"type": "string", "minLength": 1},
        "canonical_filename": {"type": "string", "minLength": 1},
        "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "page_count": {"type": "integer", "minimum": 1},
        "selected_route": {"enum": ["native", "ocr", "merged-dual"]},
        "zotero_version": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["selected_markdown", "structure"],
      "additionalProperties": false,
      "properties": {
        "selected_markdown": {"$ref": "#/$defs/hashed_input"},
        "structure": {
          "type": "object",
          "required": ["path", "sha256", "bytes", "backend", "coverage_source"],
          "additionalProperties": false,
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 0},
            "backend": {"type": "string", "minLength": 1},
            "coverage_source": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "profile": {"type": "string", "minLength": 1},
    "execution_plans": {
      "type": "object",
      "required": [
        "summarize_page",
        "summarize_section",
        "summarize_full_paper"
      ],
      "additionalProperties": false,
      "properties": {
        "summarize_page": {
          "allOf": [
            {"$ref": "model-execution-plan.schema.json"},
            {"properties": {"stage": {"const": "summarize_page"}}}
          ]
        },
        "summarize_section": {
          "allOf": [
            {"$ref": "model-execution-plan.schema.json"},
            {"properties": {"stage": {"const": "summarize_section"}}}
          ]
        },
        "summarize_full_paper": {
          "allOf": [
            {"$ref": "model-execution-plan.schema.json"},
            {"properties": {"stage": {"const": "summarize_full_paper"}}}
          ]
        }
      }
    },
    "work_units": {
      "type": "object",
      "required": [
        "summarize_page",
        "summarize_section",
        "summarize_full_paper"
      ],
      "additionalProperties": false,
      "properties": {
        "summarize_page": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/work_unit"}
        },
        "summarize_section": {
          "type": "array",
          "items": {"$ref": "#/$defs/work_unit"}
        },
        "summarize_full_paper": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/work_unit"}
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "provider_call_permitted",
        "provider_call_performed",
        "summary_outputs_generated",
        "ready_for_approved_live_execution",
        "blockers"
      ],
      "additionalProperties": false,
      "properties": {
        "provider_call_permitted": {"const": false},
        "provider_call_performed": {"const": false},
        "summary_outputs_generated": {"const": 0},
        "ready_for_approved_live_execution": {"const": false},
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "writes": {
      "type": "object",
      "required": ["source_pack", "zotero"],
      "additionalProperties": false,
      "properties": {
        "source_pack": {"const": false},
        "zotero": {"const": false}
      }
    }
  },
  "$defs": {
    "hashed_input": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "work_unit": {
      "type": "object",
      "required": ["unit_id", "source_locators"],
      "additionalProperties": false,
      "properties": {
        "unit_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "source_locators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
