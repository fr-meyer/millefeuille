{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/millefeuille/classification-action-evidence.schema.json",
  "title": "Millefeuille Classification Action Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "mode",
    "outcome",
    "taxonomy_version",
    "prior_decision_ref",
    "primary_path",
    "confidence",
    "summary",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "millefeuille-classification-action-evidence/v0.1"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "mode": {
      "enum": ["review", "adjudicate"]
    },
    "outcome": {
      "enum": [
        "no-change",
        "corrected",
        "escalated",
        "confirmed",
        "taxonomy-change-requested"
      ]
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "prior_decision_ref": {
      "$ref": "#/$defs/safeRelativeRef"
    },
    "primary_path": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/safeRelativeRef"
      }
    },
    "strongest_rejected_path": {
      "type": "string",
      "minLength": 1
    },
    "rejected_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "items": {"$ref": "#/$defs/safeRelativeRef"}
          }
        }
      }
    },
    "qa_flags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "review_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "taxonomy_change_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposed_path", "reason"],
      "properties": {
        "proposed_path": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/safeRelativeRef"}
        }
      }
    },
    "writeback_preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "add_tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "remove_tags": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "destination_collection": {"type": "string", "minLength": 1},
        "note_markdown": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "review"}}},
      "then": {"properties": {"outcome": {"enum": ["no-change", "corrected", "escalated"]}}}
    },
    {
      "if": {"properties": {"mode": {"const": "adjudicate"}}},
      "then": {"properties": {"outcome": {"enum": ["confirmed", "corrected", "taxonomy-change-requested"]}}}
    },
    {
      "if": {"properties": {"outcome": {"enum": ["escalated", "taxonomy-change-requested"]}}},
      "then": {"properties": {"review_reasons": {"minItems": 1}}, "required": ["review_reasons"]},
      "else": {"properties": {"review_reasons": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "taxonomy-change-requested"}}},
      "then": {"required": ["taxonomy_change_request"]},
      "else": {"not": {"required": ["taxonomy_change_request"]}}
    }
  ],
  "$defs": {
    "safeRelativeRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {"pattern": "(^|/)\\.\\.?($|/)"}
    }
  }
}
