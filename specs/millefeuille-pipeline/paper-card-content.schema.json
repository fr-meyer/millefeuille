{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fr-meyer/millefeuille/specs/millefeuille-pipeline/paper-card-content.schema.json",
  "title": "Transient GPT paper-card content v1",
  "$comment": "This model output is not a canonical paper card or provider execution acceptance. Consumers must also apply validate_v1_paper_card_content for exact identity and ordered source locators. It contains no index, Zotero or provenance authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "run_id",
    "source_hash",
    "source_locators",
    "one_line_thesis",
    "primary_contribution",
    "problem_addressed",
    "method_or_approach",
    "data_modality_domain",
    "main_results",
    "limitations",
    "classification_clues",
    "quality_warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_locators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^p\\.[1-9][0-9]*$"
      }
    },
    "one_line_thesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "primary_contribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "problem_addressed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "method_or_approach": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "data_modality_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "main_results": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "limitations": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "classification_clues": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      }
    },
    "quality_warnings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
      }
    }
  }
}
