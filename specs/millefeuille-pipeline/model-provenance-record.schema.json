{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fr-meyer/millefeuille/specs/millefeuille-pipeline/model-provenance-record.schema.json",
  "title": "Millefeuille Model Provenance Record",
  "type": "object",
  "$comment": "Generic Draft 2020-12 validation is necessary but not sufficient because the draft cannot express integer addition. Consumers MUST also apply x-millefeuille-semantic-validation. Token counts are capped at the exact cross-runtime JSON integer range.",
  "x-millefeuille-semantic-validation": {
    "required": true,
    "arithmetic": "exact-integer",
    "maximum_integer": 9007199254740991,
    "assertions": [
      "usage.total_tokens == usage.input_tokens + usage.output_tokens",
      "intersection(input_refs, output_refs) == []"
    ],
    "first_party_validator": {
      "name": "millefeuille.domain.model_execution.validate_model_provenance_record",
      "requires": ["model_provenance_record"]
    }
  },
  "required": [
    "schema_version",
    "profile",
    "stage",
    "requested_model",
    "resolved_model",
    "provider",
    "backend",
    "reasoning_effort",
    "fast_mode",
    "prompt_version",
    "input_refs",
    "output_refs",
    "usage",
    "quality_warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "nonEmptyUnpaddedString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000])[\\s\\S]*[^\\u0009-\\u000D\\u001C-\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000](?![\\s\\S])",
      "allOf": [{"$ref": "#/$defs/credentialFreeString"}]
    },
    "credentialFreeString": {
      "not": {
        "pattern": "[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]:\\s*(?:[Bb][Ee][Aa][Rr][Ee][Rr]|[Bb][Aa][Ss][Ii][Cc])|\\b[Bb][Ee][Aa][Rr][Ee][Rr]\\s+[A-Za-z0-9._~+/-]{8,}|[Dd][Aa][Tt][Aa]:[Aa][Pp][Pp][Ll][Ii][Cc][Aa][Tt][Ii][Oo][Nn]/[Pp][Dd][Ff]|%PDF-|sk-(?:proj-|svcacct-)?[A-Za-z0-9_-]{20,}|AIza[A-Za-z0-9_-]{20,}|(?:AKIA|ASIA)[A-Z0-9]{16}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|glpat-[A-Za-z0-9_-]{20,}|npm_[A-Za-z0-9]{20,}|dop_v1_[A-Fa-f0-9]{32,}|(?:sk|rk|pk)_(?:live|test)_[A-Za-z0-9]{16,}|hf_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|eyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}"
      }
    },
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:structure|summaries)/(?!.*//)(?!\\.\\.?(?:/|(?![\\s\\S])))(?!.*\\/\\.\\.?(?:/|(?![\\s\\S])))(?!.*\\\\)(?!.*:)[A-Za-z0-9._-](?:[A-Za-z0-9._/-]*[A-Za-z0-9._-])?(?![\\s\\S])",
      "allOf": [{"$ref": "#/$defs/credentialFreeString"}]
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "output_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "total_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "qualityWarning": {
      "type": "object",
      "required": ["code", "severity"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}(?![\\s\\S])",
          "allOf": [{"$ref": "#/$defs/credentialFreeString"}]
        },
        "severity": {"enum": ["info", "warning", "error"]},
        "ref": {"$ref": "#/$defs/safeRef"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "millefeuille-model-provenance/v0.1"},
    "profile": {"$ref": "#/$defs/nonEmptyUnpaddedString"},
    "stage": {
      "enum": [
        "summarize_page",
        "summarize_section",
        "summarize_full_paper"
      ]
    },
    "requested_model": {"$ref": "#/$defs/nonEmptyUnpaddedString"},
    "resolved_model": {"$ref": "#/$defs/nonEmptyUnpaddedString"},
    "provider": {"$ref": "#/$defs/nonEmptyUnpaddedString"},
    "backend": {"$ref": "#/$defs/nonEmptyUnpaddedString"},
    "reasoning_effort": {
      "oneOf": [
        {"enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]},
        {"type": "null"}
      ]
    },
    "fast_mode": {
      "oneOf": [
        {"enum": ["off", "on", "auto"]},
        {"type": "null"}
      ]
    },
    "prompt_version": {
      "oneOf": [
        {"$ref": "#/$defs/nonEmptyUnpaddedString"},
        {"type": "null"}
      ]
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safeRef"}
    },
    "output_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safeRef"}
    },
    "usage": {"$ref": "#/$defs/usage"},
    "quality_warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/qualityWarning"}
    }
  }
}
