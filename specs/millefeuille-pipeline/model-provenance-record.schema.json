{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fr-meyer/millefeuille/specs/millefeuille-pipeline/model-provenance-record.schema.json",
  "title": "Millefeuille Model Provenance Record",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "stage",
    "requested_model",
    "resolved_model",
    "provider",
    "backend",
    "reasoning_effort",
    "fast_mode",
    "prompt_version",
    "input_refs",
    "output_refs",
    "usage",
    "quality_warnings"
  ],
  "additionalProperties": false,
  "$defs": {
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*:)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "qualityWarning": {
      "type": "object",
      "required": ["code", "severity"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "severity": {"enum": ["info", "warning", "error"]},
        "ref": {"$ref": "#/$defs/safeRef"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "millefeuille-model-provenance/v0.1"},
    "profile": {"type": "string", "minLength": 1},
    "stage": {
      "enum": [
        "summarize_page",
        "summarize_section",
        "summarize_full_paper"
      ]
    },
    "requested_model": {"type": "string", "minLength": 1},
    "resolved_model": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1},
    "reasoning_effort": {
      "oneOf": [
        {"enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max"]},
        {"type": "null"}
      ]
    },
    "fast_mode": {
      "oneOf": [
        {"enum": ["off", "on", "auto"]},
        {"type": "null"}
      ]
    },
    "prompt_version": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safeRef"}
    },
    "output_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safeRef"}
    },
    "usage": {"$ref": "#/$defs/usage"},
    "quality_warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/qualityWarning"}
    }
  }
}
