{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/millefeuille/taxonomy-registry.schema.json",
  "title": "Millefeuille Taxonomy Registry",
  "x-millefeuille-semantic-validation": [
    "content_identity equals canonical SHA-256 excluding content_identity",
    "all strings are unpadded NFC and contain no Unicode control characters",
    "entries and set-like arrays are sorted and duplicate-free",
    "entry IDs and sibling labels are unique",
    "level, parent, replacement, active-parent, and released-tree coverage rules pass",
    "previous_version differs from taxonomy_version",
    "root registries have null previous_version and previous_content_identity; non-root registries require both"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "taxonomy_version",
    "previous_version",
    "previous_content_identity",
    "status",
    "governing_basis",
    "owner_id",
    "entries",
    "content_identity"
  ],
  "properties": {
    "schema_version": {
      "const": "millefeuille-taxonomy-registry/v0.1"
    },
    "registry_id": {"$ref": "#/$defs/safeId"},
    "taxonomy_version": {"$ref": "#/$defs/safeId"},
    "previous_version": {
      "oneOf": [
        {"$ref": "#/$defs/safeId"},
        {"type": "null"}
      ]
    },
    "previous_content_identity": {
      "oneOf": [
        {"$ref": "#/$defs/contentIdentity"},
        {"type": "null"}
      ]
    },
    "status": {
      "enum": ["draft", "released", "deprecated", "archived"]
    },
    "governing_basis": {"$ref": "#/$defs/text"},
    "owner_id": {"$ref": "#/$defs/text"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "content_identity": {"$ref": "#/$defs/contentIdentity"}
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "entryId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^\\S(?:[^\\r\\n\\u0000-\\u001f]*\\S)?$"
    },
    "contentIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sortedTextArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "level",
        "parent_id",
        "label",
        "definition",
        "include_when",
        "exclude_when",
        "boundary_notes",
        "status",
        "replacement_id"
      ],
      "properties": {
        "entry_id": {"$ref": "#/$defs/entryId"},
        "level": {"enum": [1, 2]},
        "parent_id": {
          "oneOf": [
            {"$ref": "#/$defs/entryId"},
            {"type": "null"}
          ]
        },
        "label": {"$ref": "#/$defs/text"},
        "definition": {"$ref": "#/$defs/text"},
        "include_when": {
          "allOf": [
            {"$ref": "#/$defs/sortedTextArray"},
            {"minItems": 1}
          ]
        },
        "exclude_when": {
          "allOf": [
            {"$ref": "#/$defs/sortedTextArray"},
            {"minItems": 1}
          ]
        },
        "boundary_notes": {"$ref": "#/$defs/sortedTextArray"},
        "status": {"enum": ["active", "deprecated"]},
        "replacement_id": {
          "oneOf": [
            {"$ref": "#/$defs/entryId"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"level": {"const": 1}}},
          "then": {"properties": {"parent_id": {"type": "null"}}},
          "else": {"properties": {"parent_id": {"$ref": "#/$defs/entryId"}}}
        },
        {
          "if": {"properties": {"status": {"const": "active"}}},
          "then": {"properties": {"replacement_id": {"type": "null"}}}
        }
      ]
    }
  }
}
