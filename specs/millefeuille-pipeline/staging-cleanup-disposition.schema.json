{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fr-meyer/millefeuille/specs/millefeuille-pipeline/staging-cleanup-disposition.schema.json",
  "title": "Millefeuille Staging Cleanup Disposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "plan_digest",
    "operation",
    "receipt_digest",
    "audit_identity",
    "candidate_count",
    "candidates",
    "failure_code",
    "permanent_deletion_performed",
    "private_bytes_serialized",
    "secret_material_persisted"
  ],
  "properties": {
    "schema_version": {"const": "millefeuille-staging-cleanup-disposition/v0.1"},
    "status": {
      "enum": [
        "quarantined",
        "already-quarantined",
        "failed-rolled-back",
        "recovery-required"
      ]
    },
    "plan_digest": {"$ref": "staging-cleanup-plan.schema.json#/$defs/digest"},
    "operation": {"const": "maintenance.quarantine-abandoned-retrieval-staging-and-bridge-assets"},
    "receipt_digest": {"$ref": "staging-cleanup-plan.schema.json#/$defs/digest"},
    "audit_identity": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "staging-cleanup-plan.schema.json#/$defs/digest"}
      ]
    },
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "generation_identity", "status"],
        "properties": {
          "kind": {"$ref": "staging-cleanup-plan.schema.json#/$defs/candidateKind"},
          "generation_identity": {"$ref": "staging-cleanup-plan.schema.json#/$defs/digest"},
          "status": {
            "enum": [
              "quarantined",
              "already-quarantined",
              "rolled-back",
              "rollback-blocked",
              "not-attempted",
              "ready",
              "source-and-quarantine-present",
              "source-drifted",
              "quarantine-drifted",
              "missing"
            ]
          }
        }
      }
    },
    "failure_code": {
      "enum": [null, "atomic-move-failed", "rollback-blocked", "partial-or-drifted-state"]
    },
    "permanent_deletion_performed": {"const": false},
    "private_bytes_serialized": {"const": false},
    "secret_material_persisted": {"const": false}
  },
  "x-millefeuille-semantic-validation": [
    "Candidate order and count must match the referenced strict cleanup plan; expose opaque generation identities only, never relative source paths, absolute roots, inventory, or private bytes.",
    "failed-rolled-back and recovery-required never restore receipt authority. A retry or recovery requires a separately approved plan and receipt; only an exact completed state with matching audit may report already-quarantined."
  ]
}
