{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Millefeuille classification batch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "taxonomy_version",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "millefeuille-classification-batch-manifest/v0.1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "evidence_ref"
        ],
        "properties": {
          "paper_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
          },
          "item_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
          },
          "evidence_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          }
        },
        "oneOf": [
          {
            "required": [
              "paper_id"
            ],
            "not": {
              "required": [
                "item_key"
              ]
            }
          },
          {
            "required": [
              "item_key"
            ],
            "not": {
              "required": [
                "paper_id"
              ]
            }
          }
        ]
      }
    }
  }
}
