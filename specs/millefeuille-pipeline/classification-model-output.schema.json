{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Millefeuille classification model output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "run_id",
    "source_hash",
    "taxonomy_version",
    "taxonomy_lock_identity",
    "primary_entry_id",
    "strongest_rejected_entry_id",
    "confidence",
    "rationale",
    "evidence",
    "taxonomy_gap",
    "review_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": "millefeuille-classification-model-output/v0.1"
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_lock_identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "primary_entry_id": {
      "type": "string",
      "minLength": 1
    },
    "strongest_rejected_entry_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "taxonomy_gap": {
      "type": "boolean"
    },
    "review_reasons": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locator",
          "claim"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "confidence": {
                "const": "low"
              }
            },
            "required": [
              "confidence"
            ]
          },
          {
            "properties": {
              "taxonomy_gap": {
                "const": true
              }
            },
            "required": [
              "taxonomy_gap"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "review_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
